{
  "authz": {
    "catalogue": {
      "nav.overview": {
        "kind": "baseline",
        "role": null,
        "scope": null
      },
      "nav.account": {
        "kind": "baseline",
        "role": null,
        "scope": null
      },
      "nav.api.profile": {
        "kind": "read",
        "role": "user",
        "scope": "workspace:read"
      },
      "action.api.send.read": {
        "kind": "read",
        "role": "user",
        "scope": "workspace:read"
      },
      "nav.api.projects": {
        "kind": "read",
        "role": "admin",
        "scope": "workspace:read"
      },
      "action.api.send.write": {
        "kind": "write",
        "role": "user",
        "scope": "workspace:write"
      },
      "action.projects.delete": {
        "kind": "write",
        "role": "admin",
        "scope": "workspace:write"
      },
      "data.actor.list": {
        "kind": "read",
        "role": "user",
        "scope": "workspace:read"
      },
      "data.customer.list": {
        "kind": "read",
        "role": "customers_reader",
        "scope": "workspace:read"
      },
      "data.film.list": {
        "kind": "read",
        "role": "user",
        "scope": "workspace:read"
      },
      "data.staff.list": {
        "kind": "read",
        "role": "user",
        "scope": "workspace:read"
      },
      "data.customer.details": {
        "kind": "read",
        "role": "customers_reader",
        "scope": "workspace:read"
      },
      "data.customer.write": {
        "kind": "write",
        "role": "admin",
        "scope": "workspace:write"
      },
      "data.unmapped": {
        "kind": "read",
        "role": "admin",
        "scope": "workspace:read"
      },
      "action.unmapped.write": {
        "kind": "write",
        "role": "admin",
        "scope": "workspace:write"
      }
    },
    "roles": {
      "viewer": {
        "includes": []
      },
      "user": {
        "includes": [
          "viewer"
        ]
      },
      "admin": {
        "includes": [
          "user",
          "viewer",
          "customers_reader"
        ]
      },
      "auditor": {
        "includes": [
          "viewer",
          "customers_reader"
        ]
      },
      "customers_reader": {
        "includes": []
      }
    },
    "role_map": {
      "entra": {
        "Workspace.User": "user",
        "Workspace.Admin": "admin",
        "Workspace.Viewer": "viewer",
        "Workspace.Auditor": "auditor"
      },
      "okta": {
        "Workspace User": "user",
        "Workspace Admin": "admin",
        "Workspace Viewer": "viewer",
        "Workspace Auditor": "auditor"
      },
      "google": {
        "default_role": "user"
      }
    },
    "routes": {
      "suffixes": [
        {
          "suffix": "/v1/projects",
          "capability": "nav.api.projects"
        },
        {
          "suffix": "/v1/projects/*",
          "capability": "nav.api.projects"
        },
        {
          "suffix": "/v1/projects/*/delete",
          "capability": "action.projects.delete"
        },
        {
          "suffix": "/v1/send",
          "capability": "action.api.send.write"
        },
        {
          "suffix": "/v1/send/*",
          "capability": "action.api.send.write"
        },
        {
          "suffix": "get_actor_list",
          "capability": "data.actor.list"
        },
        {
          "suffix": "get_customer_list",
          "capability": "data.customer.list"
        },
        {
          "suffix": "get_customer_details_by_params",
          "capability": "data.customer.details"
        },
        {
          "suffix": "get_film_list",
          "capability": "data.film.list"
        },
        {
          "suffix": "get_staff_list",
          "capability": "data.staff.list"
        },
        {
          "suffix": "add_customer",
          "capability": "data.customer.write"
        },
        {
          "suffix": "get_unmapped",
          "capability": "data.unmapped"
        },
        {
          "suffix": "add_unmapped",
          "capability": "action.unmapped.write"
        }
      ],
      "fallback": {
        "safe": "nav.api.profile",
        "unsafe": "action.api.send.write"
      }
    }
  }
}
