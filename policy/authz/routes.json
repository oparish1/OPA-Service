{
  "routes": {
    "suffixes": [
      { "suffix": "/v1/projects", "capability": "nav.api.projects" },
      { "suffix": "/v1/projects/*", "capability": "nav.api.projects" },
      { "suffix": "/v1/projects/*/delete", "capability": "action.projects.delete" },
      { "suffix": "/v1/send", "capability": "action.api.send.write" },
      { "suffix": "/v1/send/*", "capability": "action.api.send.write" },
      { "suffix": "get_actor_list", "capability": "data.actor.list" },
      { "suffix": "get_customer_list", "capability": "data.customer.list" },
      { "suffix": "get_customer_details_by_params", "capability": "data.customer.details" },
      { "suffix": "get_film_list", "capability": "data.film.list" },
      { "suffix": "get_staff_list", "capability": "data.staff.list" },
      { "suffix": "add_customer", "capability": "data.customer.write" },
      { "suffix": "get_unmapped", "capability": "data.unmapped" },
      { "suffix": "add_unmapped", "capability": "action.unmapped.write" }
    ],
    "fallback": {
      "safe": "nav.api.profile",
      "unsafe": "action.api.send.write"
    }
  }
}
